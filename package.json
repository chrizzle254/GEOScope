{
  "name": "geoscope",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:push": "supabase db push",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev": "turbo run dev --parallel --filter=web --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,html,yaml,yml}\"",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supabase": "^2.67.1",
    "turbo": "^2.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.2"
  }
}
