# Next.js Web App (.env.example)
# Client-safe defaults (exposed to browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ENV=development

# Server-only example (do not prefix with NEXT_PUBLIC_)
# INTERNAL_TOKEN=replace-with-secret


# Next.js Web App (.env.local)
# Client-safe variables (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_