# Next.js Web App — environment variables
# Copy to .env.local and fill in values for local dev.
# Copy to .env for production (do NOT commit real secrets).

# Supabase
# Local dev: get from `npx supabase status --output json` → ANON_KEY (JWT format)
# Production: from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your_supabase_anon_key_here

# Express API base URL (no trailing slash)
# Local dev: http://localhost:4000
# Production: https://your-api.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000